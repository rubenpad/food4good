{
  "name": "food4good-dashboard",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "npm run lint && npm run format:check && npm run typecheck"
  },
  "dependencies": {
    "@pinia/colada": "1.4.9",
    "@primeuix/themes": "2.0.3",
    "pinia": "4.1.0",
    "primevue": "4.5.5",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@tsconfig/node26": "26.0.1",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/tsconfig": "0.9.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.14"
  },
  "engines": {
    "node": ">=26"
  }
}
