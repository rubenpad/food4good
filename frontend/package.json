  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.6",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/tsconfig": "0.9.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.14"
  }
